/* resource.rc - Classic Task Manager resources */
#include <windows.h>
#include "../include/resource.h"

/* Application manifest (RT_MANIFEST == 24, CREATEPROCESS_MANIFEST_RESOURCE_ID == 1) */
1 24 "app.manifest"

IDI_APPICON             ICON            "app.ico"

/* ------------------------------------------------------------------------
 * Generic tab page.  Every tab is a child dialog created from this template;
 * the controls are created in code by the individual tab modules so that the
 * layout can follow the DPI and the window size.
 * ---------------------------------------------------------------------- */
IDD_TABPAGE DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

/* ------------------------------------------------------------------------
 * File > New Task (Run...)
 * ---------------------------------------------------------------------- */
IDD_RUNDLG DIALOGEX 0, 0, 251, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Task"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APPICON,IDC_RUN_ICON,7,7,20,20
    LTEXT           "Type the name of a program, folder, document, or Internet resource, and Task Manager will open it for you.",
                    IDC_RUN_TEXT,36,7,208,26
    LTEXT           "&Open:",IDC_RUN_LABEL,7,41,26,8
    COMBOBOX        IDC_RUN_COMBO,36,38,208,120,
                    CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Create this task with &administrative privileges.",
                    IDC_RUN_ADMIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,60,208,10
    DEFPUSHBUTTON   "OK",IDOK,139,85,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,194,85,50,14
END

/* ------------------------------------------------------------------------
 * Version information
 * ---------------------------------------------------------------------- */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "\0"
            VALUE "FileDescription",  "Task Manager - System Workspace\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "taskman\0"
            VALUE "LegalCopyright",   "\0"
            VALUE "OriginalFilename", "taskman.exe\0"
            VALUE "ProductName",      "Classic Task Manager\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
